# Godot 4 editor/cache
.godot/

# Godot 3 legacy cache (safe to ignore if ever present)
.import/

# Export presets (often machine/local-path specific)
export_presets.cfg

# .NET / C# build artifacts
bin/
obj/
.mono/

# IDE files
.vs/
.vscode/
.idea/
*.suo
*.user
*.userprefs
*.csproj.user
*.DotSettings.user

# OS files
.DS_Store
Thumbs.db

# Logs / temp
*.log
*.tmp

# Steam SDK native libraries (non versionnées — chaque dev les télécharge)
steam_api.dll
steam_api64.dll
libsteam_api.so
libsteam_api.dylib
steam_appid.txt

# Claude Code : réglages personnels (non partagés)
.claude/settings.local.json
CLAUDE.local.md
__pycache__/

# Exports du jeu (doc/EXPORT.md)
build/

# Modèles mid poly du bac à sable (plan 60) : régénérés par python3 tools/export_lowpoly.py --detail mid
assets/models/mid/
# Les autres personnages du bac à sable de la verticalité sont exportés à la demande (plan 60, §236).
assets/models/characters/*
!assets/models/characters/facteur.*

# Modèles low poly convertis pour le moteur (plan 60 §19), régénérés par tools/convert_models.sh et relief_sandbox.sh
assets/models/**/*.scn
assets/models/lods.json
